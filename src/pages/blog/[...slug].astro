---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/react/Header';
import Footer from '../../components/react/Footer';

export async function getStaticPaths() {
    const posts = await getCollection('blog');
    return posts.map((entry) => ({
        params: { slug: entry.slug },
        props: { entry },
    }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();

const lang = "en";
const site = 'https://hmz.technology';
const articleUrl = `${site}/blog/${entry.slug}`;

const formatDate = (date: Date) =>
    date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });

const articleSchema = {
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": entry.data.title,
    "description": entry.data.description,
    "datePublished": entry.data.pubDate.toISOString(),
    "dateModified": entry.data.pubDate.toISOString(),
    "inLanguage": "en",
    "mainEntityOfPage": articleUrl,
    "author": {
        "@type": "Person",
        "name": "Hasan El Zein",
        "jobTitle": "Founder",
        "worksFor": {
            "@type": "Organization",
            "name": "HMZ Technology",
            "url": site
        }
    },
    "publisher": {
        "@type": "Organization",
        "name": "HMZ Technology",
        "url": site,
        "logo": {
            "@type": "ImageObject",
            "url": `${site}/favicon.svg`
        }
    },
    "keywords": entry.data.tags.join(', ')
};

const breadcrumbSchema = {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": site },
        { "@type": "ListItem", "position": 2, "name": "Blog", "item": `${site}/blog/` },
        { "@type": "ListItem", "position": 3, "name": entry.data.title, "item": articleUrl }
    ]
};
---

<Layout title={`${entry.data.title} | HMZ Technology`} description={entry.data.description} lang={lang} dir="ltr">
    <Header lang={lang} client:load />
    <main class="relative min-h-screen bg-[#030014] overflow-hidden">
        {/* Background glow effects */}
        <div class="absolute inset-0 pointer-events-none">
            <div class="absolute top-0 right-1/4 w-96 h-96 bg-cyan-500/10 rounded-full blur-[120px]"></div>
            <div class="absolute top-1/2 left-0 w-96 h-96 bg-purple-500/10 rounded-full blur-[120px]"></div>
        </div>

        <article class="relative max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
            {/* Breadcrumb */}
            <nav aria-label="Breadcrumb" class="mb-10">
                <ol class="flex flex-wrap items-center gap-2 text-sm text-white/40">
                    <li><a href="/" class="hover:text-cyan-400 transition-colors">Home</a></li>
                    <li aria-hidden="true" class="text-white/20">/</li>
                    <li><a href="/blog" class="hover:text-cyan-400 transition-colors">Blog</a></li>
                    <li aria-hidden="true" class="text-white/20">/</li>
                    <li class="text-white/70 truncate max-w-[200px] sm:max-w-none" aria-current="page">{entry.data.title}</li>
                </ol>
            </nav>

            {/* Article Header */}
            <header class="mb-12">
                <div class="flex flex-wrap items-center gap-3 mb-6">
                    <span class="px-3 py-1 rounded-full text-xs font-semibold border capitalize text-cyan-400 bg-cyan-500/10 border-cyan-500/20">
                        {entry.data.category.replace('-', ' ')}
                    </span>
                    {entry.data.tags.slice(0, 3).map((tag) => (
                        <span class="px-3 py-1 rounded-full text-xs text-white/40 bg-white/5 border border-white/10">
                            {tag}
                        </span>
                    ))}
                </div>
                <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-white leading-tight mb-6">
                    {entry.data.title}
                </h1>
                <p class="text-lg text-white/60 leading-relaxed mb-8">
                    {entry.data.description}
                </p>
                <div class="flex flex-wrap items-center gap-x-6 gap-y-2 text-sm text-white/40 pb-8 border-b border-white/10">
                    <span class="flex items-center gap-2">
                        <span class="w-8 h-8 rounded-full bg-gradient-to-br from-cyan-500 to-purple-600 flex items-center justify-center text-xs font-bold text-white">HZ</span>
                        <span class="text-white/70">Hasan El Zein, Founder</span>
                    </span>
                    <span>Published: <time datetime={entry.data.pubDate.toISOString()}>{formatDate(entry.data.pubDate)}</time></span>
                    <span>Last updated: <time datetime={entry.data.pubDate.toISOString()} class="text-cyan-400/80">{formatDate(entry.data.pubDate)}</time></span>
                </div>
            </header>

            {/* Article Content */}
            <div class="prose-dark">
                <Content />
            </div>

            {/* Author Footer */}
            <footer class="mt-16 glass-card-ai p-8">
                <div class="flex items-start gap-4">
                    <span class="w-14 h-14 shrink-0 rounded-full bg-gradient-to-br from-cyan-500 to-purple-600 flex items-center justify-center text-lg font-bold text-white">HZ</span>
                    <div>
                        <p class="text-white font-semibold mb-1">Hasan El Zein</p>
                        <p class="text-white/50 text-sm leading-relaxed mb-3">
                            Founder of HMZ Technology — an AI agency building chatbots, voice agents, and autonomous business systems for companies across the Middle East, Europe, and North America.
                        </p>
                        <a href="/contact" class="text-cyan-400 hover:text-cyan-300 text-sm font-medium transition-colors">
                            Book a free consultation →
                        </a>
                    </div>
                </div>
            </footer>
        </article>
    </main>
    <Footer lang={lang} client:load />
    <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
</Layout>

<style is:global>
    .prose-dark {
        color: rgb(209 213 219); /* gray-300 */
        font-size: 1.0625rem;
        line-height: 1.8;
    }
    .prose-dark h2 {
        color: #fff;
        font-size: 1.75rem;
        font-weight: 700;
        line-height: 1.3;
        margin-top: 3rem;
        margin-bottom: 1.25rem;
        padding-top: 1.5rem;
        border-top: 1px solid rgba(255, 255, 255, 0.06);
    }
    .prose-dark h2:first-child {
        border-top: none;
        padding-top: 0;
        margin-top: 0;
    }
    .prose-dark h2::before {
        content: '';
        display: block;
        width: 3rem;
        height: 3px;
        margin-bottom: 1rem;
        border-radius: 2px;
        background: linear-gradient(90deg, rgb(34 211 238), rgb(168 85 247));
    }
    .prose-dark h3 {
        color: rgb(103 232 249); /* cyan-300 */
        font-size: 1.3rem;
        font-weight: 600;
        line-height: 1.4;
        margin-top: 2.25rem;
        margin-bottom: 1rem;
    }
    .prose-dark h4 {
        color: rgb(165 243 252); /* cyan-200 */
        font-size: 1.1rem;
        font-weight: 600;
        margin-top: 1.75rem;
        margin-bottom: 0.75rem;
    }
    .prose-dark p {
        margin-top: 1.25rem;
        margin-bottom: 1.25rem;
    }
    .prose-dark strong {
        color: #fff;
        font-weight: 600;
    }
    .prose-dark a {
        color: rgb(34 211 238); /* cyan-400 */
        text-decoration: underline;
        text-decoration-color: rgba(34, 211, 238, 0.35);
        text-underline-offset: 3px;
        transition: color 0.2s, text-decoration-color 0.2s;
    }
    .prose-dark a:hover {
        color: rgb(165 243 252);
        text-decoration-color: rgb(165 243 252);
    }
    .prose-dark ul, .prose-dark ol {
        margin-top: 1.25rem;
        margin-bottom: 1.25rem;
        padding-left: 1.5rem;
    }
    .prose-dark ul { list-style: none; }
    .prose-dark ul > li {
        position: relative;
        padding-left: 1rem;
    }
    .prose-dark ul > li::before {
        content: '';
        position: absolute;
        left: -0.75rem;
        top: 0.7em;
        width: 6px;
        height: 6px;
        border-radius: 9999px;
        background: linear-gradient(135deg, rgb(34 211 238), rgb(168 85 247));
    }
    .prose-dark ol { list-style: decimal; }
    .prose-dark ol > li::marker {
        color: rgb(34 211 238);
        font-weight: 600;
    }
    .prose-dark li {
        margin-top: 0.5rem;
        margin-bottom: 0.5rem;
    }
    .prose-dark blockquote {
        margin: 2rem 0;
        padding: 1.25rem 1.5rem;
        border-left: 3px solid rgb(34 211 238);
        background: rgba(34, 211, 238, 0.05);
        border-radius: 0 12px 12px 0;
        color: rgb(229 231 235);
        font-style: italic;
    }
    .prose-dark blockquote p { margin: 0.5rem 0; }
    .prose-dark code {
        color: rgb(103 232 249);
        background: rgba(34, 211, 238, 0.08);
        border: 1px solid rgba(34, 211, 238, 0.15);
        padding: 0.15rem 0.4rem;
        border-radius: 6px;
        font-size: 0.875em;
    }
    .prose-dark pre {
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 12px;
        padding: 1.25rem 1.5rem;
        overflow-x: auto;
        margin: 1.75rem 0;
    }
    .prose-dark pre code {
        background: transparent;
        border: none;
        padding: 0;
        color: rgb(209 213 219);
    }
    .prose-dark table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0;
        margin: 2rem 0;
        font-size: 0.9375rem;
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 12px;
        overflow: hidden;
    }
    .prose-dark thead th {
        background: rgba(34, 211, 238, 0.08);
        color: rgb(103 232 249);
        font-weight: 600;
        text-align: left;
        padding: 0.875rem 1rem;
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    }
    .prose-dark tbody td {
        padding: 0.75rem 1rem;
        border-bottom: 1px solid rgba(255, 255, 255, 0.05);
        color: rgb(209 213 219);
    }
    .prose-dark tbody tr:last-child td { border-bottom: none; }
    .prose-dark tbody tr:hover { background: rgba(255, 255, 255, 0.02); }
    .prose-dark hr {
        border: none;
        height: 1px;
        background: linear-gradient(90deg, transparent, rgba(34, 211, 238, 0.3), transparent);
        margin: 3rem 0;
    }
    .prose-dark img {
        border-radius: 12px;
        border: 1px solid rgba(255, 255, 255, 0.08);
        margin: 2rem 0;
    }
</style>
